@page "/auth/lockout"
@model LockoutModel
@{
    ViewData["Title"] = L["Account locked"].Value;
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="text-center">
    <div class="mb-4">
        <svg class="inline-block w-8 h-8 text-slate-500 dark:text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0110 0v4"></path>
        </svg>
    </div>
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">@L["Account locked"]</h2>
    @if (Model.LockoutEnd.HasValue)
    {
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">
            @L["Your account is temporarily locked after too many failed sign-in attempts."]
        </p>
        <p class="text-sm font-medium text-slate-900 dark:text-slate-100 mb-6" id="lockout-countdown"
           data-until="@Model.LockoutEnd.Value.ToUnixTimeMilliseconds()">
            @L["Try again in a few minutes."]
        </p>
    }
    else
    {
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">
            @L["Your account is temporarily locked after too many failed sign-in attempts."] @L["Try again in a few minutes."]
        </p>
    }
    <a href="/auth/login" class="text-indigo-600 dark:text-indigo-400 hover:underline text-sm">@L["Back to sign in"]</a>
</div>

@if (Model.LockoutEnd.HasValue)
{
    <script>
    (function () {
        var el = document.getElementById('lockout-countdown');
        var until = parseInt(el.dataset.until, 10);
        var youCanTryNow = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["You can try signing in again now."].Value));
        var tryAgainTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Try again in {0}m {1}s."].Value));

        function render() {
            var remainingMs = until - Date.now();
            if (remainingMs <= 0) {
                el.textContent = youCanTryNow;
                return;
            }
            var minutes = Math.floor(remainingMs / 60000);
            var seconds = Math.floor((remainingMs % 60000) / 1000);
            el.textContent = tryAgainTemplate.replace('{0}', minutes).replace('{1}', seconds);
            setTimeout(render, 1000);
        }
        render();
    })();
    </script>
}
